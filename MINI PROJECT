                            theme='theme1'
                            legendPos='center.top'
                            heightType='auto'
                            heightValue='300px'
                            appLinkName='thisapp'
                            formLinkName='Complaint_Resolution'
                            xfield='Complaint_Status'
                            yfields='count:Complaint_Status'
                            quickFilters='Complaint_Status'
                        />
                    </column>
                </row>
            </layout>
            </zml>"
        }
    }


    /*
     * VALIDATION AND EMAIL WORKFLOWS
     */

    workflow
    {
        form
        {
            Validate_Complaint as "Validate Complaint Details"
            {
                type = form
                form = Complaint_Form
                record event = on add

                on validate
                {
                    actions
                    {
                        custom deluge script
                        (
                            if(input.Complaint_Title == "")
                            {
                                alert "Please enter a complaint title.";
                                cancel submit;
                            }

                            if(input.Complaint_Description == "")
                            {
                                alert "Please describe your complaint.";
                                cancel submit;
                            }
                        )
                    }
                }
            }

            Send_Complaint_Acknowledgement as "Send Complaint Acknowledgement"
            {
                type = form
                form = Complaint_Form
                record event = on add

                on success
                {
                    actions
                    {
                        sendmail
                        (
                            from : "zoho.adminuserid"
                            to : Email_Address
                            subject : "Complaint Received Successfully"
                            message : "<div>Dear Complainant,</div><br><div>Your complaint has been registered successfully.</div><br><div>Complaint Title: ${Complaint_Title}</div><div>Category: ${Complaint_Category}</div><div>Department: ${Department}</div><div>Submission Date: ${Submission_Date}</div><br><div>Our team will review your complaint and take appropriate action.</div><br><div>Thank you,<br>Complaint Management Team</div>"
                        )
                    }
                }
            }

            Send_Resolution_Notification as "Send Resolution Notification"
            {
                type = form
                form = Complaint_Resolution
                record event = on add

                on success
                {
                    actions
                    {
                        sendmail
                        (
                            from : "zoho.adminuserid"
                            to : "complaints.admin@example.com"
                            subject : "Complaint Resolution Record Updated"
                            message : "A complaint resolution record has been added. Reference: ${Complaint_Reference}. Status: ${Complaint_Status}. Please review the resolution details."
                        )
                    }
                }
            }
        }


        /*
         * COMPLAINT LIFECYCLE
         */

        blueprint
        {
            Complaint_Lifecycle as "Complaint Lifecycle"
            {
                type = Blueprint
                form = Complaint_Form

                start
                {
                }

                stages
                {
                }

                transitions
                {
                }
            }
        }
    }


